---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Home"
  description="Logan Lyle — an operator who builds. Operations, finance, analytics, automation, and health-tech."
>
  <section>
    <div class="eyebrow">Logan Lyle</div>
    <h1>An operator who builds.</h1>
    <p class="lede">
      I work across operations, finance, analytics, and automation — with deep roots in
      health-tech — and I build the systems I use myself.
    </p>
    <a class="btn" href="/work/">See the work →</a>
  </section>

  <section>
    <div class="pillar-grid">
      <div class="pillar">
        <div class="eyebrow">Operations &amp; finance</div>
        <p>Running the systems underneath a business — process, reporting, and the finance
          close that actually holds up.</p>
      </div>
      <div class="pillar">
        <div class="eyebrow">Automation &amp; product</div>
        <p>Designing and building the tools I use, not just recommending them — from
          internal automation to shipped software.</p>
      </div>
      <div class="pillar">
        <div class="eyebrow">Health-tech</div>
        <p>Pharmacy benefit management and healthcare operations, from the inside —
          co-founded and scaled a PBM through to exit.</p>
      </div>
    </div>
  </section>

  <section>
    <h2>Selected work</h2>
    <div class="entry">
      <h3>Wellyfe</h3>
      <p class="role">Co-founder · Pharmacy benefit management · Exited 2026</p>
      <p>Co-founded and helped build a PBM business from the ground up, through to a
        successful exit.</p>
    </div>
    <div class="entry">
      <h3>Simon</h3>
      <p class="role">Personal chief-of-staff system · Ongoing</p>
      <p>A private automation system I designed and run for my own use — calendar, email,
        and task management with explicit governance and approval boundaries.</p>
    </div>
    <a class="btn outline" href="/work/">All work →</a>
  </section>
</BaseLayout>
